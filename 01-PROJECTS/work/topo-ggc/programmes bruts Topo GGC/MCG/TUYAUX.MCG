# tuyaux.ced	parametres
# a partir du caractere # ignore par pgm y compris le #
# sens : domaine prive vers public
DEPART		3	# 0m60
ARRIVEE		6	# 1m20
HMOD		0.20	# 0m20 hauteur des modules
pentemini	3	# 3%
arrondil	1.	# arrondir la longueur a 1m ( par val sup )


hxbte/pte -1.0 0.6	# hx boite, hx pente si - pas d'ecriture
symregard pol3  0.5	# taille regard 0m50
radiers radiers 4 60   1 501   51	00	0.6  0
tampons tampons 3 60   1 0	0	50	0.6  0

#tamp/rad
#	nomcalque
#               plu(=couleur)
#                 bloc plan			     coter en z
#		         trai	ept1	symboleregard
#						hecriture
# trai 1=continu, 0 pas de trait
# ept1=epaisseur du trai ( 0 = plume)
# symbole 0 aucun
# coter en z : poids	1 le 1er
#			2 le dernier
#			4 les intermediaires
# ex 3 le 1er et le dernier, 7 tous, 0 aucun

regards		0.4 1.5 0.6
#		dimension regard = taille symbole regard
#		0m40x0m40
#		    jusqu'a 1m50
#			0m60 au-dela

pompes 49 1 104 51 70 1
#     symbole      bloc
#	 hx           plan
#	   trai
#	       ept1


dessin 190 267 200 28	# format/x format/y echelle masque haut
#			   190 mm   267 mm  1/200    28 mm
centreformat 1	# saisir les centres des formats
#centreformat 0	# centrage automatique des formats sur les tuyaux
police pol3		# style ecriture
titre 3 3 3 3  0.2 0  0.2 0  0.2 0  0 0# hx lig1 2 3 4 (saisie) dx dy
Departement de l'Aisne                              Commune de BONNEIL
Syndicat Assainissement Chezy Azy Bonneil
                                         Section     parcelle
CEDRAT DEVELOPPEMENT

# titre suivi des 4 lignes d'entete des formats
#     hx ecriture des 4 lignes ici 3 mm
#              decalage en xy pour epaissir les ecritures
#		ici 0.2 mm en x, 0 en y pour les 3 1eres lignes
#		ligne 4 0,0 , italique ( d'office )
