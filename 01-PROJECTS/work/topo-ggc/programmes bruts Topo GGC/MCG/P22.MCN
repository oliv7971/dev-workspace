#DXFTAB
#TAB35                   #nom de la table de symboles
#NUL                     #nom du fichier de symboles DXF

DXFSEMIS
1 2 3 10 20 30          #2 1 3 10 20 38 pour ACAD version 9
pique 2                 #piques jaune
numero 4                #numeros bleu clair
altitudes 3 2           #altitudes vert
3                       #unit‚ rotation ‚critures semis 1=rd 2=deg 3=grad
cart  3                 #r‚serv‚
2                       #position ecritures  1 ou 2
#code_pt   plan    trait  couleur       99 lignes maxi
02       Z-ASSAIN    1       1


