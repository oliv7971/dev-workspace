#Formater un fichier NXYZ(C) en colonnes:
#Formats: 64 caracteres maxi,   1ere ligne = avec code
#                               2eme ligne = sans code
NXYZC
(I5,1X,F10.3,1X,F10.3,1X,F7.3,1X,I2)
(I5,1X,F10.3,1X,F10.3,1X,F7.3)

