#        j        =1 message 531 avec <I> reponse standard
#        j        =2 message 531 avec <V>    "
#        j        =3 message 531 avec <D>    "
#        j        =4 message 531 avec <F>    "
#           k     =1 ...Pnnn termine... est suivi du message 606(ok <o>/n)
#			(relance de Pnnn sans chargement a partir du disque)
#		  =0 pas de message 606 (pas de relance possible)

