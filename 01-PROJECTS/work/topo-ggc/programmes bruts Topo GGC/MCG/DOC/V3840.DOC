        tex1,,-No-PLANCHE-1/1000-:-752-233 # 1er caractere donnera espace
        tex2,,-STRUCTURE-:            # meme consigne que P58, ici -
        tex3,,-Km-PLANCHE-1/1000-:
        ktgv            #abscisse du pk 0 de la planche, consigne SNCF
        419218.423      #sur cette ligne
        FORX,420
        FORZ,297
        BSNY,700
        ECHX,200
        ECHZ,200
        bsnx,430
        bsny,300
