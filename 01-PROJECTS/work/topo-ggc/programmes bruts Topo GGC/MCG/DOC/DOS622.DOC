LH /L:0;1,50448 /S C:\WINDOWS\SMARTDRV.EXE  16384
path c:\mcg;c:\UTIL;c:\b;C:\DOS;C:\me;c:\lf90\bin;c:\sf90;c:\acad;c:\f500;c:\windows;c:\;c:\edit
SET TEMP=C:\WINDOWS\TEMP
c:\dos\KEYB FR,,C:\DOS\KEYBOARD.SYS
