mode com2:96,e,7,2
mode com1:96,e,7,2
SET ACAD=c:\ACAD\SUPPORT;c:\ACAD\FONTS;c:\acad\ads
set ACADCFG=c:\ACAD
set ACADDRV=c:\ACAD\DRV

c:
chkdsk/f
set comspec=c:\command.com
@SET SCSI_DRIVER = C:\IOMEGA
@SET SCSI_UTILITY = C:\IOMEGA

