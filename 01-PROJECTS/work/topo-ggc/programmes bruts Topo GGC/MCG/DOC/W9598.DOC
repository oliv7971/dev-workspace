    lh doskey
    rem c:\windows\smartdrv /x 16184
    rem TShoot: c:\maestro.com


    	windows 98 !!!!!!!!!!! config.sys


    device=c:\windows\himem.sys
    device=c:\windows\emm386.exe noems
    dos=high,umb
    rem TShoot: DEVICE=c:\aecu.sys /s:00010000
    rem device=C:\WINDOWS\COMMAND\display.sys con=(ega,,1)
    Country=033,850,C:\WINDOWS\COMMAND\country.sys
    devicehigh=c:\windows\command\ansi.sys
    devicehigh=c:\windows\setver.exe
