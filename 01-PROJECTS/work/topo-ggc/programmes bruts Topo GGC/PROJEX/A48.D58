plco,103636,/P.C.
dctn,103618,/DISTANCES/TERRAIN/NATUREL
altn,103618,/ALTITUDES/TERRAIN/NATUREL
libr,103618
libr,103618
libr,103618
libr,103618
FIN
AFFICHE,1,  AFFICHAGE SUR ECRAN ET REPASSER EN MODE ALPHA
COMM        EN FIN D'AFFICHAGE
#CMCG  sortir le code pour Pytha-Graph
travers,16
ECHX,100
ECHZ,100
FORZ,210
forx,297
STITRE,,A48
plco,190
calx,80  #calage du 0 a 80 mm
nbds,2 # 2 decimales pour les x
nbdz,2 # 2 decimales pour les Z
superpose
# mettre ici  A48tn
tn,,exec
