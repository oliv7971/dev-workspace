{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Exécuter fichier actuel",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["${file}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "PowerShell: Exécuter script",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-File", "${file}"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
